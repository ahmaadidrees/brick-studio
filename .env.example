# Frontend environment variables (Vite only exposes names prefixed VITE_).
# Copy to .env.local for local development; *.local files are git-ignored.
# Leave everything unset to run the studio as a fully local guest build with no backend.

# Origin of the Cloudflare Worker that serves the classroom API (/classroom/*):
# teacher sign-in, class codes, My Worlds, My Class. Unset = classroom features
# are unavailable; guest building still works.
VITE_CLASSROOM_SERVER_URL=

# Origin of the Cloudflare Worker that hosts live "Build together" rooms
# (/worlds/*). Usually the same Worker as above. Unset = invite links are unavailable.
VITE_LIVE_SERVER_URL=

# Absolute public origin (no trailing slash) used for Open Graph / Twitter card
# URLs in index.html. Defaults to the committed value in .env.production;
# override only for a differently named deployment.
VITE_PUBLIC_ORIGIN=
