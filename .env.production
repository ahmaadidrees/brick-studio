# Loaded by `vite build` (production mode) and committed on purpose.
# This is the ONE place the public origin lives: index.html reads it as
# %VITE_PUBLIC_ORIGIN% to build absolute Open Graph / Twitter card URLs.
# A VITE_PUBLIC_ORIGIN set in the deploy environment (or .env.production.local)
# takes precedence over this default.
VITE_PUBLIC_ORIGIN=https://brickgineers.com
