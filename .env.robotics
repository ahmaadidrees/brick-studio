# Loaded by `vite --mode robotics` only (never by `npm run dev` / `vite build`).
# Isolated local Robot Workshop spike: the robotics parts, creation card and mechanics
# nudge appear only when VITE_ROBOTICS_PROTOTYPE is exactly "1". The classroom and live
# origins are pinned to the literal `off` so the studio never resolves the default
# localhost:8787 worker or any production origin while the spike runs.
VITE_ROBOTICS_PROTOTYPE=1
VITE_PUBLIC_ORIGIN=http://127.0.0.1:5232
VITE_CLASSROOM_SERVER_URL=off
VITE_LIVE_SERVER_URL=off
VITE_RACE_SERVER_URL=off
